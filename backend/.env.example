# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
JWT_SECRET="replace-with-a-long-random-secret"

# Used only by `npm run bootstrap:admin`.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"
ADMIN_NAME="HireDesk Admin"

# Brevo is required to send activation emails for Admin-provisioned users.
BREVO_API_KEY=""
BREVO_FROM=""
FRONTEND_URL="http://localhost:3000"

# Google OAuth (optional; required only for Google sign-in).
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
